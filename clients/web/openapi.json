{
  "openapi": "3.1.0",
  "info": {
    "title": "Mobility Management Agent API",
    "summary": "Synthetic, governed airport-access decision framework",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Capabilities",
        "operationId": "capabilities_api_v1_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/demo/trip": {
      "get": {
        "tags": [
          "demo"
        ],
        "summary": "Get Demo Trip",
        "operationId": "get_demo_trip_api_v1_demo_trip_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripInput"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/decisions/preview": {
      "post": {
        "tags": [
          "decisions"
        ],
        "summary": "Preview Decision",
        "operationId": "preview_decision_api_v1_decisions_preview_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CapabilitiesResponse": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "data_scope": {
            "type": "string",
            "const": "synthetic",
            "title": "Data Scope"
          },
          "provider": {
            "type": "string",
            "const": "fake",
            "title": "Provider"
          },
          "planned_model": {
            "type": "string",
            "const": "gpt-5.6-sol",
            "title": "Planned Model"
          },
          "features": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Features"
          },
          "blocked_actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Blocked Actions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "service",
          "version",
          "data_scope",
          "provider",
          "planned_model",
          "features",
          "blocked_actions"
        ],
        "title": "CapabilitiesResponse"
      },
      "DecisionComponent": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "minutes": {
            "type": "integer",
            "maximum": 360.0,
            "minimum": 0.0,
            "title": "Minutes"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "label",
          "minutes",
          "evidence_ids"
        ],
        "title": "DecisionComponent"
      },
      "DecisionResponse": {
        "properties": {
          "trip": {
            "$ref": "#/components/schemas/TripInput"
          },
          "decision": {
            "$ref": "#/components/schemas/DepartureDecision"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "type": "array",
            "title": "Evidence"
          },
          "assistant_summary": {
            "type": "string",
            "title": "Assistant Summary"
          },
          "verified": {
            "type": "boolean",
            "title": "Verified"
          },
          "runtime": {
            "$ref": "#/components/schemas/RuntimeBoundary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "trip",
          "decision",
          "evidence",
          "assistant_summary",
          "verified",
          "runtime"
        ],
        "title": "DecisionResponse"
      },
      "DepartureDecision": {
        "properties": {
          "recommended_leave_at": {
            "type": "string",
            "format": "date-time",
            "title": "Recommended Leave At"
          },
          "latest_reasonable_leave_at": {
            "type": "string",
            "format": "date-time",
            "title": "Latest Reasonable Leave At"
          },
          "target_terminal_arrival": {
            "type": "string",
            "format": "date-time",
            "title": "Target Terminal Arrival"
          },
          "scheduled_departure": {
            "type": "string",
            "format": "date-time",
            "title": "Scheduled Departure"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Risk Level"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Confidence"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/DecisionComponent"
            },
            "type": "array",
            "title": "Components"
          },
          "binding_constraints": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Binding Constraints"
          },
          "assumptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Assumptions"
          },
          "policy_version": {
            "type": "string",
            "const": "synthetic-demo-1.0.0",
            "title": "Policy Version",
            "default": "synthetic-demo-1.0.0"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recommended_leave_at",
          "latest_reasonable_leave_at",
          "target_terminal_arrival",
          "scheduled_departure",
          "risk_level",
          "confidence",
          "components",
          "binding_constraints",
          "assumptions"
        ],
        "title": "DepartureDecision"
      },
      "EvidenceItem": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "value": {
            "type": "string",
            "title": "Value"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "user_confirmed",
              "synthetic_rule",
              "derived"
            ],
            "title": "Source Type"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          },
          "fresh_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fresh Until"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "synthetic",
              "derived"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "evidence_id",
          "label",
          "value",
          "source",
          "source_type",
          "observed_at",
          "confidence",
          "status"
        ],
        "title": "EvidenceItem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "data_scope": {
            "type": "string",
            "const": "synthetic",
            "title": "Data Scope"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "service",
          "version",
          "environment",
          "data_scope"
        ],
        "title": "HealthResponse"
      },
      "RiskProfile": {
        "type": "string",
        "enum": [
          "standard",
          "cautious",
          "very_cautious"
        ],
        "title": "RiskProfile"
      },
      "RuntimeBoundary": {
        "properties": {
          "data_scope": {
            "type": "string",
            "const": "synthetic",
            "title": "Data Scope"
          },
          "provider": {
            "type": "string",
            "const": "fake",
            "title": "Provider"
          },
          "planned_model": {
            "type": "string",
            "const": "gpt-5.6-sol",
            "title": "Planned Model"
          },
          "persistence": {
            "type": "string",
            "const": "none",
            "title": "Persistence"
          },
          "automatic_booking": {
            "type": "boolean",
            "const": false,
            "title": "Automatic Booking"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data_scope",
          "provider",
          "planned_model",
          "persistence",
          "automatic_booking"
        ],
        "title": "RuntimeBoundary"
      },
      "TripInput": {
        "properties": {
          "flight_number": {
            "type": "string",
            "pattern": "^[A-Z0-9]{2}\\d{3,4}$",
            "title": "Flight Number"
          },
          "departure_airport": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Departure Airport"
          },
          "terminal": {
            "type": "string",
            "maxLength": 12,
            "minLength": 1,
            "title": "Terminal",
            "default": "待确认"
          },
          "scheduled_departure": {
            "type": "string",
            "format": "date-time",
            "title": "Scheduled Departure"
          },
          "departure_place": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Departure Place"
          },
          "checked_baggage": {
            "type": "boolean",
            "title": "Checked Baggage",
            "default": false
          },
          "risk_profile": {
            "$ref": "#/components/schemas/RiskProfile",
            "default": "cautious"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "flight_number",
          "departure_airport",
          "scheduled_departure",
          "departure_place"
        ],
        "title": "TripInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
