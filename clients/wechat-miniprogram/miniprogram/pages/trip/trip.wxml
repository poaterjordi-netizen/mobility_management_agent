<view class="page-shell trip-page">
  <view class="section-kicker">IMPORT &amp; CONFIRM</view>
  <view class="page-heading">用 3 步生成出发建议</view>
  <view class="page-copy">先填写去机场的出发地，再粘贴已经订好的航班通知，最后确认识别出的字段。</view>

  <view class="quick-example">
    <view class="quick-title">北京交大 → 首都机场 → 大连 → 大连理工</view>
    <view class="quick-copy">一键载入 CA8908 测试；21:50 是计划起飞，不是 21:00 才离开学校。</view>
    <button class="quick-button" bindtap="loadBjtuDutExample">直接查看这条测试建议</button>
  </view>

  <view class="panel intake-card">
    <view class="step-title"><text class="step-number">1</text><view>从哪里出发去机场？</view></view>
    <input
      class="origin-input"
      data-field="departure_place"
      maxlength="80"
      placeholder="例如：北京交通大学（海淀校区）"
      placeholder-class="field-placeholder"
      value="{{draft.departure_place}}"
      bindinput="handleTextInput"
    />
    <view class="step-help">这是去机场的起点，不是航班出发机场。</view>

    <view class="step-title second-step"><text class="step-number">2</text><view>粘贴已经订好的航班通知</view></view>
    <view class="step-help">必须包含航班号和计划起飞时间；不要把希望离校的时间填成航班时间。</view>
    <view class="intake-tabs">
      <button
        wx:for="{{intakeOptions}}"
        wx:key="value"
        class="intake-tab {{intakeMode === item.value ? 'active' : ''}}"
        data-mode="{{item.value}}"
        bindtap="handleIntakeMode"
      >{{item.label}}</button>
    </view>

    <textarea
      wx:if="{{intakeMode !== 'image'}}"
      class="intake-textarea"
      maxlength="50000"
      value="{{intakeText}}"
      placeholder="{{intakeMode === 'ics' ? '粘贴 BEGIN:VCALENDAR…' : '例如：【国航】CA8908，北京首都 T3 → 大连周水子，2026/7/27 21:50 起飞'}}"
      bindinput="handleIntakeText"
    ></textarea>
    <view wx:else class="image-picker" bindtap="chooseImage">
      <view class="image-mark">＋</view>
      <view class="image-title">{{intakeImageName || "选择 PNG / JPEG 行程截图"}}</view>
      <view class="image-help">最大 5 MB；服务端临时文件在识别后删除</view>
    </view>
    <button class="primary-button parse-button" loading="{{parsing}}" disabled="{{parsing}}" bindtap="parseIntake">
      解析航班通知
    </button>
  </view>

  <view wx:if="{{candidate}}" class="panel candidate-card">
    <view class="candidate-top">
      <view>
        <view class="section-kicker">STEP 3 · CONFIRM</view>
        <view class="candidate-flight">{{candidate.flight_number || "航班号待确认"}}</view>
      </view>
      <view class="candidate-source">{{candidate.itinerary_source}} · {{candidate.source_type}}</view>
    </view>
    <view class="candidate-row"><text class="candidate-label">机场</text><text class="candidate-value">{{candidate.departure_airport || "待确认"}} → {{candidate.destination_airport || "待确认"}}</text></view>
    <view class="candidate-row"><text class="candidate-label">航站楼</text><text class="candidate-value">{{candidate.terminal || "待确认"}}</text></view>
    <view class="candidate-row"><text class="candidate-label">起飞</text><text class="candidate-value">{{candidateTime}}</text></view>
    <view class="candidate-row"><text class="candidate-label">已遮盖</text><text class="candidate-value">{{candidateRedactions}}</text></view>
    <view wx:for="{{candidate.warnings}}" wx:key="*this" class="candidate-warning">! {{item}}</view>
    <button class="ghost-button candidate-button" bindtap="applyCandidate">确认识别结果并补齐字段</button>
  </view>

  <view wx:if="{{error}}" class="form-error">{{error}}</view>

  <view wx:if="{{loading}}" class="panel loading-panel">
    <view class="loading-line loading-wide"></view>
    <view class="loading-line"></view>
    <view class="loading-line loading-short"></view>
  </view>

  <form wx:else class="panel trip-form" bindsubmit="saveTrip">
    <view class="form-title">补齐后生成建议</view>
    <view class="field">
      <view class="field-label">航班号</view>
      <input class="field-input" data-field="flight_number" maxlength="6" placeholder="例如 CA1234" placeholder-class="field-placeholder" value="{{draft.flight_number}}" bindinput="handleTextInput" />
    </view>

    <view class="field-grid">
      <view class="field compact-field">
        <view class="field-label">出发机场</view>
        <input class="field-input" data-field="departure_airport" maxlength="3" placeholder="PEK" placeholder-class="field-placeholder" value="{{draft.departure_airport}}" bindinput="handleTextInput" />
      </view>
      <view class="field compact-field">
        <view class="field-label">目的机场（可选）</view>
        <input class="field-input" data-field="destination_airport" maxlength="3" placeholder="SHA" placeholder-class="field-placeholder" value="{{draft.destination_airport}}" bindinput="handleTextInput" />
      </view>
    </view>

    <view class="field">
      <view class="field-label">航站楼</view>
      <input class="field-input" data-field="terminal" maxlength="12" placeholder="T3" placeholder-class="field-placeholder" value="{{draft.terminal}}" bindinput="handleTextInput" />
    </view>

    <view class="field-grid">
      <view class="field compact-field">
        <view class="field-label">起飞日期</view>
        <picker mode="date" start="{{minimumDate}}" value="{{departureDate}}" bindchange="handleDateChange">
          <view class="picker-field">{{departureDate || "请选择"}} 〉</view>
        </picker>
      </view>
      <view class="field compact-field">
        <view class="field-label">起飞时间</view>
        <picker mode="time" value="{{departureTime}}" bindchange="handleTimeChange">
          <view class="picker-field">{{departureTime || "请选择"}} 〉</view>
        </picker>
      </view>
    </view>
    <view class="timezone-note">时间按中国标准时间（UTC+8）提交。</view>

    <view class="field-grid">
      <view class="field compact-field">
        <view class="field-label">经度（可选）</view>
        <input class="field-input" data-field="longitude" type="digit" placeholder="116.400000" value="{{longitude}}" bindinput="handleCoordinateInput" />
      </view>
      <view class="field compact-field">
        <view class="field-label">纬度（可选）</view>
        <input class="field-input" data-field="latitude" type="digit" placeholder="39.900000" value="{{latitude}}" bindinput="handleCoordinateInput" />
      </view>
    </view>

    <view class="field">
      <view class="field-label">已知活动、施工、封路或事故（每行一条）</view>
      <textarea class="notes-textarea" maxlength="600" value="{{disruptionNotes}}" placeholder="最多 5 条；低可信信号只增加有限缓冲" bindinput="handleNotesInput"></textarea>
    </view>

    <view class="field">
      <view class="field-label">风险偏好</view>
      <picker mode="selector" range="{{riskOptions}}" range-key="label" value="{{riskIndex}}" bindchange="handleRiskChange">
        <view class="picker-field">{{riskOptions[riskIndex].label}} 〉</view>
      </picker>
    </view>

    <view class="switch-list">
      <view class="switch-field">
        <view><view class="field-label">托运行李</view><view class="field-help">增加值机流程预算</view></view>
        <switch checked="{{draft.checked_baggage}}" color="#24D6C7" data-field="checked_baggage" bindchange="handleBooleanChange"></switch>
      </view>
      <view class="switch-field">
        <view><view class="field-label">需要无障碍协助</view><view class="field-help">增加流程与步行缓冲</view></view>
        <switch checked="{{draft.accessibility_assistance}}" color="#24D6C7" data-field="accessibility_assistance" bindchange="handleBooleanChange"></switch>
      </view>
      <view class="switch-field consent-field">
        <view><view class="field-label">允许本次实时航班与地图查询</view><view class="field-help">查询公开 ADS-B/获权航班来源；坐标完整且在预计离家前 3 小时内时查询高德实时路线</view></view>
        <switch checked="{{draft.live_data_consent}}" color="#24D6C7" data-field="live_data_consent" bindchange="handleBooleanChange"></switch>
      </view>
      <view class="switch-field consent-field">
        <view><view class="field-label">允许模型解释本次派生证据</view><view class="field-help">不发送住址、票号、姓名或原始截图</view></view>
        <switch checked="{{draft.model_egress_consent}}" color="#24D6C7" data-field="model_egress_consent" bindchange="handleBooleanChange"></switch>
      </view>
    </view>

    <button class="primary-button submit-button" form-type="submit" loading="{{saving}}" disabled="{{saving}}">确认并生成建议</button>
    <button class="ghost-button reset-button" bindtap="clearDraft">清空本次填写</button>
  </form>

  <view class="privacy-note">
    <view class="privacy-mark">!</view>
    <view>
      <view class="privacy-title">不抓取第三方 App 私有页面</view>
      <view class="privacy-copy">携程、航旅纵横等内容只接受用户主动导入或未来经官方授权的接口；地图、模型与提醒分别受同意门禁保护。</view>
    </view>
  </view>
</view>
