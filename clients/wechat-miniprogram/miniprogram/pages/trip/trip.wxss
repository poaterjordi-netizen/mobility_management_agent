.trip-page {
  padding-top: 54rpx;
}

.quick-example {
  margin-top: 30rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(36, 214, 199, 0.24);
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(36, 214, 199, 0.1), rgba(15, 31, 49, 0.94));
}

.quick-title {
  color: #eef6fc;
  font-size: 25rpx;
  font-weight: 650;
}

.quick-copy {
  margin-top: 10rpx;
  color: #8499ad;
  font-size: 19rpx;
  line-height: 1.6;
}

.quick-button {
  min-height: 76rpx;
  margin: 22rpx 0 0;
  border-radius: 18rpx;
  color: #07111f;
  font-size: 22rpx;
  font-weight: 650;
  background: #24d6c7;
}

.intake-card,
.trip-form {
  margin-top: 38rpx;
  padding: 30rpx;
}

.step-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #dce8f2;
  font-size: 23rpx;
  font-weight: 650;
}

.step-number {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #07111f;
  font-size: 19rpx;
  background: #24d6c7;
}

.second-step {
  margin-top: 34rpx;
}

.step-help {
  margin: 10rpx 0 0 52rpx;
  color: #687e92;
  font-size: 18rpx;
  line-height: 1.5;
}

.origin-input {
  min-height: 82rpx;
  margin-top: 16rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(36, 214, 199, 0.2);
  border-radius: 18rpx;
  box-sizing: border-box;
  color: #eef6fc;
  font-size: 25rpx;
  background: rgba(4, 13, 24, 0.45);
}

.intake-tabs {
  display: flex;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: rgba(4, 13, 24, 0.45);
}

.intake-tab {
  flex: 1;
  min-height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 15rpx;
  color: #7f94a9;
  font-size: 20rpx;
  line-height: 68rpx;
  background: transparent;
}

.intake-tab.active {
  color: #24d6c7;
  background: rgba(36, 214, 199, 0.1);
}

.intake-textarea,
.notes-textarea {
  width: 100%;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 18rpx;
  box-sizing: border-box;
  color: #eef6fc;
  background: rgba(4, 13, 24, 0.45);
}

.intake-textarea {
  height: 230rpx;
  margin-top: 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
}

.notes-textarea {
  height: 170rpx;
  margin-top: 11rpx;
  font-size: 22rpx;
  line-height: 1.55;
}

.image-picker {
  display: flex;
  min-height: 220rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  margin-top: 20rpx;
  border: 1rpx dashed rgba(36, 214, 199, 0.25);
  border-radius: 20rpx;
  background: rgba(36, 214, 199, 0.04);
}

.image-mark {
  color: #24d6c7;
  font-size: 46rpx;
}

.image-title {
  margin-top: 10rpx;
  color: #dce8f2;
  font-size: 23rpx;
}

.image-help {
  margin-top: 8rpx;
  color: #687e92;
  font-size: 18rpx;
}

.parse-button {
  margin-top: 20rpx;
}

.candidate-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.candidate-top,
.candidate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.candidate-flight {
  margin-top: 9rpx;
  color: #eef6fc;
  font-size: 39rpx;
  font-weight: 700;
}

.candidate-source {
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  color: #24d6c7;
  font-size: 17rpx;
  background: rgba(36, 214, 199, 0.09);
}

.candidate-row {
  min-height: 66rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
  color: #d8e5ee;
  font-size: 21rpx;
}

.candidate-label {
  color: #70869a;
}

.candidate-value {
  text-align: right;
}

.candidate-warning {
  margin-top: 14rpx;
  color: #e9c98f;
  font-size: 19rpx;
  line-height: 1.5;
}

.candidate-button {
  margin-top: 22rpx;
}

.form-title {
  margin-bottom: 28rpx;
  color: #eef6fc;
  font-size: 28rpx;
  font-weight: 650;
}

.field {
  margin-top: 28rpx;
}

.field:first-child {
  margin-top: 0;
}

.field-grid {
  display: flex;
  gap: 18rpx;
}

.compact-field {
  width: calc(50% - 9rpx);
}

.field-label {
  color: #8499ad;
  font-size: 20rpx;
}

.field-input,
.picker-field {
  min-height: 80rpx;
  margin-top: 11rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 18rpx;
  box-sizing: border-box;
  color: #eef6fc;
  font-size: 25rpx;
  line-height: 80rpx;
  background: rgba(4, 13, 24, 0.45);
}

.field-placeholder {
  color: #536a7e;
}

.field-help,
.timezone-note {
  margin-top: 9rpx;
  color: #687e92;
  font-size: 18rpx;
  line-height: 1.5;
}

.timezone-note {
  margin: 14rpx 4rpx 0;
}

.switch-field {
  display: flex;
  align-items: center;
}

.switch-list {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.switch-field {
  min-height: 95rpx;
  justify-content: space-between;
  gap: 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.065);
}

.switch-field:last-child {
  border-bottom: 0;
}

.consent-field {
  margin-top: 10rpx;
}

.submit-button {
  margin-top: 38rpx;
}

.reset-button {
  margin-top: 16rpx;
}

.form-error {
  margin-top: 26rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  color: #ffc2c2;
  font-size: 21rpx;
  line-height: 1.55;
  background: rgba(255, 102, 102, 0.08);
}

.loading-panel {
  margin-top: 38rpx;
  padding: 34rpx;
}

.loading-line {
  width: 65%;
  height: 28rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
}

.loading-line:first-child {
  margin-top: 0;
}

.loading-wide {
  width: 92%;
  height: 70rpx;
}

.loading-short {
  width: 42%;
}

.privacy-note {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(36, 214, 199, 0.12);
  border-radius: 22rpx;
  background: rgba(36, 214, 199, 0.045);
}

.privacy-mark {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  color: #07111f;
  font-size: 20rpx;
  font-weight: 700;
  background: #24d6c7;
}

.privacy-title {
  color: #dce8f2;
  font-size: 23rpx;
  font-weight: 650;
}

.privacy-copy {
  margin-top: 7rpx;
  color: #758a9e;
  font-size: 20rpx;
  line-height: 1.65;
}
