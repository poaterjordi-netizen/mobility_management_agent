.about-page {
  padding-top: 54rpx;
}

.boundary-card {
  margin-top: 34rpx;
  padding: 28rpx;
}

.boundary-item,
.policy-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.boundary-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.075);
}

.boundary-item:first-child {
  padding-top: 0;
}

.boundary-item:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.item-mark {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 14rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.allowed {
  color: #07111f;
  background: #24d6c7;
}

.blocked {
  color: #efb4b4;
  background: rgba(255, 102, 102, 0.1);
}

.item-title {
  color: #e8f1f8;
  font-size: 24rpx;
  font-weight: 650;
}

.item-copy {
  margin-top: 7rpx;
  color: #788da1;
  font-size: 20rpx;
  line-height: 1.65;
}

.policy-title {
  margin: 48rpx 4rpx 20rpx;
  font-size: 31rpx;
  font-weight: 680;
}

.policy-list {
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.policy-item {
  padding: 26rpx 4rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.policy-index {
  flex: 0 0 auto;
  color: #24d6c7;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
}

.website-card {
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(36, 214, 199, 0.055);
}

.website-label {
  color: #a9bbc9;
  font-size: 21rpx;
}

.website-url {
  margin-top: 10rpx;
  color: #24d6c7;
  font-size: 20rpx;
  word-break: break-all;
}

.copy-button {
  margin-top: 22rpx;
}

.legal-note {
  margin-top: 28rpx;
  color: #5f7488;
  font-size: 18rpx;
  line-height: 1.65;
}
