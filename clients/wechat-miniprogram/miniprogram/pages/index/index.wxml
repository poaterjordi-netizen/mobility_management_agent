<view class="page">
  <view class="glow glow-one"></view>
  <view class="glow glow-two"></view>

  <view class="brand-row">
    <view class="brand">
      <view class="brand-mark">↗</view>
      <view>
        <view class="brand-name">行前</view>
        <view class="brand-en">AI MOBILITY CONCIERGE</view>
      </view>
    </view>
    <view class="scope"><view class="scope-dot"></view>{{dataScope}} · v{{serviceVersion || "0.4.0"}}</view>
  </view>

  <view class="hero">
    <view class="eyebrow">下一段旅程 · 可核验建议</view>
    <view class="hero-title">明天去机场，<text>几点出发？</text></view>
    <view class="hero-copy">融合航班时间窗、机场流程、道路分位数、天气和事件信号，再由确定性引擎完整复核。</view>
    <view class="hero-actions">
      <button class="hero-primary" bindtap="goTrip">导入或编辑行程</button>
      <button class="hero-secondary" bindtap="goSettings">检查数据源</button>
    </view>
  </view>

  <view wx:if="{{error}}" class="error-card">
    <view class="error-title">暂时无法完成操作</view>
    <view class="error-copy">{{error}}</view>
    <button class="retry-button" bindtap="retry">重新连接</button>
  </view>

  <view wx:elif="{{loading}}" class="loading-card">
    <view class="skeleton skeleton-wide"></view>
    <view class="skeleton"></view>
    <view class="skeleton skeleton-short"></view>
  </view>

  <block wx:elif="{{result}}">
    <view wx:if="{{calculating}}" class="calculating-banner">正在按新偏好重新核验…</view>
    <view class="recommendation-card">
      <view class="card-top">
        <view class="verified">✓ {{verifiedLabel}}</view>
        <view class="risk">{{riskOptions[riskIndex].label}}方案</view>
      </view>
      <view class="leave-label">建议离开出发地</view>
      <view class="leave-time">{{leaveTime}}</view>
      <view class="latest">最晚参考时间 {{latestTime}}</view>

      <view class="timeline">
        <view class="line"></view>
        <view class="timeline-item">
          <view class="point point-active"></view>
          <view class="timeline-time">{{leaveTime}}</view>
          <view class="timeline-label">离开出发地</view>
        </view>
        <view class="timeline-item">
          <view class="point"></view>
          <view class="timeline-time">{{terminalTime}}</view>
          <view class="timeline-label">到达 {{trip.departure_airport}} {{trip.terminal}}</view>
        </view>
        <view class="timeline-item">
          <view class="point"></view>
          <view class="timeline-time">{{departureTime}}</view>
          <view class="timeline-label">计划起飞</view>
        </view>
      </view>

      <view class="assistant-note">
        <view class="note-mark">✦</view>
        <view>{{result.assistant_summary}}</view>
      </view>
      <view class="decision-meta">
        <text>{{confidenceLabel}}</text>
        <text>{{evidenceCount}} 项证据</text>
        <text>{{result.decision.policy_version}}</text>
      </view>
    </view>

    <view class="trip-card">
      <view class="section-label">CONFIRMED INPUT</view>
      <view class="flight-row">
        <view class="flight-number">{{trip.flight_number}}</view>
        <view class="flight-date">{{departureDate}}</view>
      </view>
      <view class="trip-place">{{trip.departure_place}}</view>
      <view class="route-label">{{trip.departure_airport}} {{trip.terminal}} → {{trip.destination_airport || "目的地待确认"}}</view>
      <view class="route-label">来源：{{trip.itinerary_source || "manual"}}（用户确认）</view>

      <view class="control-row">
        <view>
          <view class="control-label">风险偏好</view>
          <picker mode="selector" range="{{riskOptions}}" range-key="label" value="{{riskIndex}}" bindchange="handleRiskChange">
            <view class="picker-value">{{riskOptions[riskIndex].label}} 〉</view>
          </picker>
        </view>
        <view class="baggage-control">
          <view class="control-label">托运行李</view>
          <switch checked="{{trip.checked_baggage}}" color="#24D6C7" bindchange="handleBaggageChange"></switch>
        </view>
      </view>
      <button class="edit-trip-button" bindtap="goTrip">确认或修改全部行程字段</button>
    </view>

    <view class="context-title">本次决策上下文</view>
    <scroll-view class="context-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="context-row">
        <view class="context-card">
          <view class="context-label">航班时间窗</view>
          <view class="context-value">值机截止 {{checkinCloseTime}}</view>
          <view class="context-help">登机口 {{result.context.flight.gate || "待定"}}</view>
        </view>
        <view class="context-card">
          <view class="context-label">机场流程</view>
          <view class="context-value">安检 {{result.context.airport.security_minutes}} · 步行 {{result.context.airport.walking_minutes}} 分</view>
          <view class="context-help">约 {{result.context.airport.gate_distance_meters || "—"}} 米</view>
        </view>
        <view class="context-card">
          <view class="context-label">道路分位数</view>
          <view class="context-value">P50 {{result.context.route.p50_minutes}} · P90 {{result.context.route.p90_minutes}} 分</view>
          <view class="context-help">{{result.context.route.metadata.source_name}}</view>
        </view>
        <view class="context-card">
          <view class="context-label">机场天气</view>
          <view class="context-value">{{result.context.weather.summary}}</view>
          <view class="context-help">缓冲 {{result.context.weather.buffer_minutes}} 分钟</view>
        </view>
        <view wx:if="{{telemetryLabel}}" class="context-card live-context-card">
          <view class="context-label">ADS-B 实时遥测</view>
          <view class="context-value">{{telemetryLabel}}</view>
          <view class="context-help">最近信号 {{telemetryTime}}</view>
        </view>
        <view wx:if="{{metarLabel}}" class="context-card live-context-card">
          <view class="context-label">机场 METAR 实况</view>
          <view class="context-value">{{metarLabel}}</view>
          <view class="context-help">观测 {{metarTime}}</view>
        </view>
      </view>
    </scroll-view>
    <view wx:if="{{sourceWarnings.length}}" class="source-warning-list">
      <view wx:for="{{sourceWarnings}}" wx:key="*this">! {{item}}</view>
    </view>

    <view class="evidence-title">每一分钟都有依据</view>
    <view class="component-list">
      <view wx:for="{{result.decision.components}}" wx:key="key" class="component-row">
        <text>{{item.label}}</text><text>{{item.minutes}} 分钟</text>
      </view>
    </view>
    <view class="evidence-grid">
      <view wx:for="{{result.evidence}}" wx:for-item="evidence" wx:key="evidence_id" class="evidence-card">
        <view class="evidence-label">{{evidence.label}}</view>
        <view class="evidence-value">{{evidence.value}}</view>
        <view class="evidence-source">{{evidence.source}}</view>
        <view class="evidence-meta">{{evidence.status}} · {{evidence.completeness}}</view>
        <button wx:if="{{evidence.source_url}}" class="source-link" data-url="{{evidence.source_url}}" bindtap="copyEvidenceSource">复制来源链接</button>
      </view>
    </view>

    <view class="workflow-title">提醒与行动</view>
    <view class="workflow-card">
      <view class="workflow-head"><view><view class="reminder-title">T-24 出发提醒</view><view class="reminder-copy">生成可检查的提醒内容，不会静默订阅或发送。</view></view><view class="workflow-mark">24h</view></view>
      <button class="workflow-button" loading="{{workflowBusy === 'reminder'}}" disabled="{{workflowBusy !== ''}}" bindtap="previewReminder">{{reminder ? "重新生成" : "预览提醒"}}</button>
      <view wx:if="{{reminder}}" class="workflow-result">
        <view class="result-strong">{{reminderTime}}</view>
        <view>{{reminder.message}}</view>
        <button class="result-action" bindtap="copyReminder">复制提醒内容</button>
      </view>
    </view>

    <view class="workflow-card">
      <view class="workflow-head"><view><view class="reminder-title">地图与叫车入口</view><view class="reminder-copy">先展示参数，再经第二次确认复制高德官方链接。</view></view><view class="workflow-mark">↗</view></view>
      <button class="workflow-button" loading="{{workflowBusy === 'action'}}" disabled="{{workflowBusy !== ''}}" bindtap="proposeAction">{{actionProposal ? "更新提案" : "生成操作提案"}}</button>
      <view wx:if="{{actionProposal}}" class="workflow-result">
        <view wx:for="{{actionParameters}}" wx:key="label" class="action-row"><text>{{item.label}}</text><text>{{item.value}}</text></view>
        <button class="result-action primary-result" bindtap="confirmAction">确认并复制官方地图链接</button>
      </view>
    </view>

    <view class="workflow-card">
      <view class="workflow-head"><view><view class="reminder-title">证据受限问答</view><view class="reminder-copy">回答只能引用本次证据，缺少覆盖时会明确说明。</view></view><view class="workflow-mark">?</view></view>
      <input class="question-input" value="{{question}}" maxlength="300" placeholder="为什么这么早出发？" bindinput="handleQuestion" />
      <button class="workflow-button" loading="{{workflowBusy === 'question'}}" disabled="{{workflowBusy !== ''}}" bindtap="askQuestion">询问 Agent</button>
      <view wx:if="{{answer}}" class="workflow-result">
        <view class="result-strong">{{answer.answer}}</view>
        <view>引用：{{citedEvidence || "无"}}</view>
        <view>Provider：{{answer.provider}}</view>
      </view>
    </view>
  </block>

  <view class="boundary">
    <view class="boundary-title">模型负责理解，代码负责决定</view>
    <view>服务端默认不持久化行程、位置、截图或问答；不会抓取其他 App、自动叫车或付款。</view>
    <button class="clear-button" bindtap="clearSession">清空本次会话</button>
  </view>
</view>
