# Tracked examples must contain no real credentials or personal data.
MOBILITY_ENV=development
MOBILITY_DATA_MODE=synthetic
MOBILITY_API_HOST=127.0.0.1
MOBILITY_API_PORT=8000
MOBILITY_WEB_ORIGIN=http://127.0.0.1:5173
MOBILITY_TIMEZONE=Asia/Shanghai

# Offline deterministic mode is the default.
MOBILITY_ASSISTANT_PROVIDER=fake
MOBILITY_ASSISTANT_MODEL=gpt-5.6-sol
MOBILITY_ASSISTANT_REASONING_EFFORT=medium
MOBILITY_MODEL_INTENT_EGRESS=deny
MOBILITY_MODEL_EVIDENCE_EGRESS=deny

# Runtime-only integrations. Inject secrets from an approved secret manager.
OPENAI_API_KEY=
OPENAI_BASE_URL=
DASHSCOPE_API_KEY=
AMAP_WEB_SERVICE_KEY=
MOBILITY_DATABASE_URL=
MOBILITY_OBJECT_STORAGE_BUCKET=

# Side effects stay blocked until separately approved.
MOBILITY_REMINDER_DELIVERY_ENABLED=false
MOBILITY_RIDE_HAILING_ACTIONS_ENABLED=false
MOBILITY_PRODUCTION_ENABLED=false
