{
  "registry_version": "0.4.2",
  "status": "real-data-preview",
  "capabilities": [
    {
      "id": "guided_trip_input",
      "status": "implemented",
      "clients": ["web", "wechat-miniprogram"],
      "steps": ["departure_place", "booked_itinerary", "field_confirmation"],
      "automatic_demo_loading": false,
      "requires_user_confirmation": true
    },
    {
      "id": "full_journey_acceptance_example",
      "status": "implemented",
      "clients": ["web", "wechat-miniprogram"],
      "contract": "docs/examples/bjtu_pek_ca8908_evening_request.json",
      "last_mile": "DLC to DUT LingShui campus",
      "automatic_booking": false
    },
    {
      "id": "create_trip_candidate",
      "status": "implemented",
      "clients": ["web", "wechat-miniprogram"],
      "tools": ["trip.parse_text", "trip.parse_ics", "trip.parse_image_local_ocr"],
      "requires_user_confirmation": true,
      "persistence": "none"
    },
    {
      "id": "confirm_trip",
      "status": "implemented",
      "clients": ["web", "wechat-miniprogram"],
      "tools": ["trip.confirm"],
      "requires_user_confirmation": true
    },
    {
      "id": "build_journey_context",
      "status": "implemented-with-provider-gates",
      "tools": [
        "flight.get_snapshot",
        "flight.get_public_adsb_telemetry",
        "airport.get_process_snapshot",
        "route.get_snapshot",
        "route.get_amap_live_driving",
        "weather.get_snapshot",
        "weather.get_official_metar",
        "events.get_user_signals",
        "events.match_official_advisories"
      ],
      "fallback": "versioned conservative rules",
      "source_status_visible": true
    },
    {
      "id": "compute_departure_decision",
      "status": "implemented",
      "tools": ["decision.compute", "decision.verify"],
      "requires_complete_evidence": true,
      "policy_version": "decision-policy-0.4.1",
      "model_can_override": false
    },
    {
      "id": "explain_decision",
      "status": "implemented",
      "tools": ["decision.explain", "decision.answer_evidence_question"],
      "model_policy": "evidence-only",
      "default_provider": "deterministic-template",
      "optional_model": "gpt-5.6-sol"
    },
    {
      "id": "preview_reminder",
      "status": "implemented",
      "tools": ["reminder.preview", "reminder.export_ics"],
      "requires_user_consent": true,
      "channels": ["calendar", "web-preview", "wechat-copy"]
    },
    {
      "id": "wechat_subscription_delivery",
      "status": "guarded",
      "requires": [
        "template-id",
        "server-side-appsecret",
        "user-subscription-consent",
        "idempotent-outbox"
      ]
    },
    {
      "id": "open_ride_hailing",
      "status": "implemented",
      "tools": ["action.build_amap_official_uri"],
      "requires_user_confirmation": true,
      "automatic_booking": false,
      "automatic_payment": false
    },
    {
      "id": "privacy_controls",
      "status": "implemented-stateless",
      "tools": ["privacy.export", "privacy.delete_session"],
      "stored_personal_data": false
    },
    {
      "id": "book_ride",
      "status": "blocked",
      "tools": []
    },
    {
      "id": "read_other_apps",
      "status": "blocked",
      "tools": []
    }
  ]
}
